# Commit-safe form (issue #1870): the liberty below is written relative
# to $PDK_ROOT, which Yosys does NOT expand -- this file is the artifact
# to commit, not the one to run. Run the rehydrated sibling
# 'synth_crypto_rot_top.run.ys' (regenerated by every `klt synthesize` run), or
# substitute your own PDK install root for $PDK_ROOT first.
read_liberty -lib $PDK_ROOT/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
read_verilog rtl/sha256/sha256_core.v
read_verilog rtl/hmac/hmac_sha256.v
read_verilog rtl/keyladder/keyladder.v
read_verilog rtl/aes/aes_core.v
read_verilog rtl/drbg/ctr_drbg.v
read_verilog rtl/trng_if/trng_if.v
read_verilog rtl/drbg/drbg_top.v
read_verilog rtl/crypto_rot_top.v
hierarchy -check -top crypto_rot_top
synth -top crypto_rot_top
dfflibmap -liberty $PDK_ROOT/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
tee -q -o flow/build/freshness/crypto_rot_top/.klt/synthesize/run-0af599ab95524a4a9a2c0f2ee8035edc/crypto_rot_top_abc.log abc -liberty $PDK_ROOT/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -constr flow/build/freshness/crypto_rot_top/.klt/synthesize/run-0af599ab95524a4a9a2c0f2ee8035edc/crypto_rot_top_abc.constr -dont_use sky130_fd_sc_hd__lpflow_* -dont_use sky130_fd_sc_hd__probe*
clean
setundef -zero
hilomap -hicell sky130_fd_sc_hd__conb_1 HI -locell sky130_fd_sc_hd__conb_1 LO
tee -q -o flow/build/freshness/crypto_rot_top/.klt/synthesize/run-0af599ab95524a4a9a2c0f2ee8035edc/crypto_rot_top_stats.json stat -liberty $PDK_ROOT/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -json -top crypto_rot_top
write_verilog -noattr flow/build/freshness/crypto_rot_top/.klt/synthesize/run-0af599ab95524a4a9a2c0f2ee8035edc/crypto_rot_top_synth.v
